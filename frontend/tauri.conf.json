{
  "productName": "ligora",
  "version": "0.1.0",
  "identifier": "com.ligora.app",
  "build": {
    "frontend": {
      "devServer": {
        "port": 1420,
        "polling": true
      }
    },
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "appVersion": "0.1.0"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Ligora",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "snap"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Science",
    "shortDescription": "Molecular analysis workstation",
    "longDescription": "Ligora is a molecular analysis workstation for protein-ligand interaction analysis.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "vina",
          "cmd": "vina",
          "args": true
        },
        {
          "name": "gnina",
          "cmd": "gnina",
          "args": true
        },
        {
          "name": "plip",
          "cmd": "plip",
          "args": true
        }
      ]
    },
    "dialog": true,
    "fs": {
      "scope": ["$HOME/.ligora/**", "$XDG_DOCUMENTS/**"]
    }
  }
}
